# Copy this file to .env and fill in the values. .env is ignored by git: never commit real keys.

# --- Required -------------------------------------------------------------------------------
# Gemini API key from https://aistudio.google.com (the free tier works for this project).
GEMINI_API_KEY=

# --- Database (defaults match docker-compose.yml and the container from the setup notes) ----
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=nestlearn

# --- AI models (optional) ------------------------------------------------------------------
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Search and background job (optional) --------------------------------------------------
# Hide search results farther than this cosine distance (0 = identical meaning, 1 = unrelated).
# Tune it by looking at the "distance" values your searches return. Unset = no cutoff.
# SEARCH_MAX_DISTANCE=0.55
# Set to false to stop the job that re-embeds photos when the embedding model changes.
# EMBEDDING_BACKFILL=true

# --- Files (optional) ----------------------------------------------------------------------
# UPLOAD_DIR=uploads

# --- Local development helper (optional, NEVER on a deployed server) -----------------------
# With DEV_AUTO_LOGIN=true, opening /api in the browser signs you in as the account below,
# so Swagger UI works without typing credentials. The account must already exist.
# DEV_AUTO_LOGIN=false
# DEV_LOGIN_EMAIL=
# DEV_LOGIN_PASSWORD=

# --- Optional monitoring (https://observe.nestjs.com) --------------------------------------
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
